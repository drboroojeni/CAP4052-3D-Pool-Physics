{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "Pool game - Windows x64 Debug",
      "description": "Normal student build. Included library sources are prepared automatically.",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/b/x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "",
        "BUILD_RENDERER": true,
        "BUILD_TESTING": false,
        "POOL_USE_SYSTEM_DEPS": false
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ],
          "intelliSenseMode": "windows-msvc-x64"
        }
      }
    },
    {
      "name": "windows-arm64-debug",
      "displayName": "Pool game - Windows ARM64 Debug (optional)",
      "description": "Requires the optional ARM64 MSVC target tools.",
      "inherits": "windows-x64-debug",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/b/arm64-debug",
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ],
          "intelliSenseMode": "windows-msvc-arm64"
        }
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (installed GLFW/GLM)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/b/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_RENDERER": true,
        "BUILD_TESTING": true,
        "POOL_USE_SYSTEM_DEPS": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "physics-only",
      "displayName": "Optional physics tests (no graphics)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/b/physics-only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_RENDERER": false,
        "BUILD_TESTING": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "targets": [
        "CAP4052_DF5_Pool"
      ]
    },
    {
      "name": "windows-arm64-debug",
      "configurePreset": "windows-arm64-debug",
      "targets": [
        "CAP4052_DF5_Pool"
      ]
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "physics-only",
      "configurePreset": "physics-only"
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "physics-only",
      "configurePreset": "physics-only",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
